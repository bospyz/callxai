generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
}

enum CallStatus {
  NEW
  PROCESSING
  DONE
  ERROR
}

enum IntegrationType {
  AMOCRM
  BITRIX24
  WEBHOOK
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
}

enum PaymentRequestStatus {
  PENDING
  CONTACTED
  PAID
  CANCELLED
}

enum CallTaskStatus {
  NEW
  PROCESSING
  DONE
  ERROR
}

enum CallDirection {
  INBOUND
  OUTBOUND
  UNKNOWN
}

model Company {
  id               String   @id @default(cuid())
  stripeCustomerId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  name                String
  phone               String?
  onboardingCompleted Boolean @default(false)

  users           User[]
  managers        Manager[]
  calls           Call[]
  subscriptions   Subscription[]
  integrations    Integration[]
  paymentRequests PaymentRequest[]

  @@index([name])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email        String  @unique
  passwordHash String
  name         String?
  role         Role    @default(MANAGER)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  passwordResetTokens PasswordResetToken[] // <-- ДОБАВЬ ЭТО
}

model PaymentRequest {
  id String @id @default(cuid())

  company   Company @relation(fields: [companyId], references: [id])
  companyId String

  plan        String
  fullName    String
  companyName String
  phone       String
  email       String

  // НОВЫЕ ПОЛЯ под форму биллинга
  billingDetails String // номер Kaspi / счёт / БИН и т.п.
  comment        String? // опциональный комментарий

  status PaymentRequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Manager {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name  String
  email String?
  phone String?

  /// внешний ID пользователя в amoCRM
  amoUserId String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  calls Call[]

  // ✅ ВАЖНО: уникальность менеджера в рамках компании по amoUserId
  @@unique([companyId, amoUserId], name: "companyId_amoUserId")
  @@index([companyId])
}

model Call {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  managerId String?
  manager   Manager? @relation(fields: [managerId], references: [id])

  /// внешний ID звонка в amoCRM / телефонии
  externalId String?

  /// URL записи (как в amo/телефонии)
  audioUrlExternal String?

  /// путь/URL на нашем сторидже (S3 и т.п.)
  audioUrl String?

  /// длительность в секундах
  duration Int?

  /// когда состоялся звонок (из amo) — это твой callDateTime
  occurredAt DateTime?

  /// направление звонка
  direction CallDirection?

  /// номер клиента (можно маскировать уже в UI)
  clientPhone String?

  /// номер / линия / ОКК, на который звонили
  linePhone String?

  /// amoCRM: ID сделки (lead)
  leadId   String?
  leadName String?
  leadUrl  String?

  /// amoCRM: воронка / проект (Arena Sunset / Arena Apart и т.д.)
  pipelineId   String?
  pipelineName String?

  /// amoCRM: стадия воронки
  stageId   String?
  stageName String?

  /// сумма сделки (для money-аналитики)
  amountKzt Int?

  status CallStatus @default(NEW)

  /// старые поля — оставляем, чтобы не сломать существующий код
  transcript String?
  score      Int?
  sentiment  String?
  meta       Json?

  // связь с задачами обработки
  tasks CallTask[]

  // новые связи
  callScore      CallScore?
  callTranscript CallTranscript?

  @@unique([companyId, externalId])
  @@index([companyId])
  @@index([managerId])
  @@index([status])
  @@index([createdAt])
  @@index([externalId])
  @@index([occurredAt])
  @@index([leadId])
}

model CallScore {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  callId String @unique
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)

  /// общий AI Call Score 0–100
  totalScore Int

  /// детальные метрики 0–10
  greetingScore     Int?
  reactionScore     Int?
  empathyScore      Int?
  needsScore        Int?
  presentationScore Int?
  priceScore        Int?
  objectionsScore   Int?
  closingScore      Int?
  clarityScore      Int?

  /// процент речи менеджера, 0–100
  talkRatioManager Float?

  /// оценка “оптимальности” длины звонка
  lengthScore Int?

  /// краткое резюме звонка
  summary String?

  /// список проблем / ошибок (структурированный)
  issues Json?

  /// пояснения по каждой метрике (метрика → текст)
  details Json?
}

model CallTranscript {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  callId String @unique
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)

  /// полный текст (если хочешь строкой)
  rawTranscript String?

  /// структурированная транскрипция:
  /// спикеры, таймкоды, блоки (приветствие/вопросы/возражения/закрытие)
  structured Json?
}

model Integration {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type    IntegrationType
  enabled Boolean         @default(true)
  config  Json?

  @@unique([companyId, type], name: "companyId_type")
}

model Subscription {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  plan             String
  seats            Int                @default(1)
  pricePerMonthKZT Int                @default(0)
  status           SubscriptionStatus @default(ACTIVE)

  callsLimitPerMonth Int @default(200) // <-- ЛИМИТ звонков в месяц

  @@index([companyId, status])
}

model AmoTrialUsage {
  amoDomain       String   @id
  usedByCompanyId String
  createdAt       DateTime @default(now())
}

model CallTask {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  callId String @unique

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  status   CallTaskStatus @default(NEW)
  error    String?
  attempts Int            @default(0)

  lockedAt      DateTime?
  nextRunAt     DateTime?
  lastAttemptAt DateTime?

  @@index([status, nextRunAt])
  @@index([lockedAt])
  @@index([status, createdAt])
}
