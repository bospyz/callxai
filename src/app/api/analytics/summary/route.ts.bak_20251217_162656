import { NextRequest, NextResponse } from "next/server";
import { db } from "@/lib/db";
import { requireAuthWithCompany } from "@/lib/auth-guard";
import { CallStatus } from "@prisma/client";

function clampInt(v: any, min: number, max: number, fallback: number) {
  const n = Number(v);
  if (!Number.isFinite(n)) return fallback;
  return Math.max(min, Math.min(max, Math.floor(n)));
}

function dateFromDays(days: number) {
  const d = new Date();
  d.setDate(d.getDate() - days);
  return d;
}

export async function GET(req: NextRequest) {
  try {
    const auth = await requireAuthWithCompany(req);
    const companyId = auth.companyId;

    const { searchParams } = new URL(req.url);
    const days = clampInt(searchParams.get("days"), 1, 365, 30);

    const from = dateFromDays(days);

    // 1) counts by status
    const grouped = await db.call.groupBy({
      by: ["status"],
      where: { companyId, createdAt: { gte: from } },
      _count: { _all: true },
    });

    const counts: Record<string, number> = {};
    for (const g of grouped) counts[g.status] = g._count._all;

    const totalCalls = grouped.reduce((acc, g) => acc + g._count._all, 0);
    const doneCalls = counts[CallStatus.DONE] ?? 0;
    const errorCalls = counts[CallStatus.ERROR] ?? 0;
    const processingCalls =
      (counts[CallStatus.NEW] ?? 0) + (counts[CallStatus.PROCESSING] ?? 0);



    return NextResponse.json({
      ok: true,
      analytics: {
        totalCalls,
        doneCalls,
        errorCalls,
        processingCalls,
      },
      range: { days, from: from.toISOString() },
    });
  } catch (e: any) {
    const msg = e?.message ?? "Failed to load analytics summary";
    return NextResponse.json({ ok: false, message: msg }, { status: 400 });
  }
}
