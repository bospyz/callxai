// src/app/api/cron/process-calls/route.ts
import { NextRequest, NextResponse } from "next/server";
import { db } from "@/lib/db";
import { CallStatus } from "@prisma/client";
import { enqueueCallTask } from "@/lib/workers/task-queue";
import { processCall } from "@/lib/call-analysis";
import {
  resetStuckTasks,
  listDueTasks,
  claimTask,
  markTaskDone,
  markTaskError,
} from "@/lib/workers/task-runner";

async function acquireCronLock(key: string, ttlMs: number) {
  const now = new Date();
  const expiresAt = new Date(now.getTime() + ttlMs);

  try {
    await db.cronLock.create({ data: { key, expiresAt } });
    return true;
  } catch (e: any) {
    const existing = await db.cronLock.findUnique({ where: { key } });
    if (!existing) return false;
    if (existing.expiresAt <= now) {
      await db.cronLock.update({ where: { key }, data: { lockedAt: now, expiresAt } });
      return true;
    }
    return false;
  }
}

async function releaseCronLock(key: string) {
  try { await db.cronLock.delete({ where: { key } }); } catch {}
}


const CRON_SECRET = process.env.CRON_SECRET;

function getErrorMessage(e: unknown): string {
  if (e instanceof Error) return e.message;
  try {
    return typeof e === "string" ? e : JSON.stringify(e);
  } catch {
    return String(e);
  }
}

function clampInt(v: any, min: number, max: number) {
  const n = Number(v);
  if (!Number.isFinite(n)) return min;
  return Math.max(min, Math.min(max, Math.floor(n)));
}

export async function GET(req: NextRequest) {
  const { searchParams } = new URL(req.url);
  const secret = searchParams.get("secret");

  if (!CRON_SECRET || secret !== CRON_SECRET) {
    return NextResponse.json({ ok: false, message: "Forbidden" }, { status: 403 });
  }

  // На Vercel безопаснее 10–20
  const limit = clampInt(searchParams.get("limit") ?? "15", 1, 20);

  // Сколько NEW calls (без задач) можно подстраховочно энкьюить
  const seedLimit = clampInt(searchParams.get("seed") ?? "20", 0, 50);

  try {
    // 0) Best-effort seed: если есть NEW calls, но нет задач — создадим задачи (idempotent)
    let seeded = 0;
    if (seedLimit > 0) {
      const newCalls = await db.call.findMany({
        where: { status: CallStatus.NEW, tasks: { none: {} } },
        orderBy: { createdAt: "asc" },
        take: seedLimit,
        select: { id: true },
      });

      for (const c of newCalls) {
        await enqueueCallTask(c.id);
        seeded += 1;
      }
    }

    // 1) Reset stuck tasks (твоя функция принимает Date и вернёт count)
    const resetCount = await resetStuckTasks(new Date());

    // 2) Берём due tasks и пытаемся их залочить (claim) по одной, атомарно
    const due = await listDueTasks(limit, new Date());

    const tasks: Array<{ id: string; callId: string; attempts: number }> = [];
    for (const t of due) {
      const ok = await claimTask(t.id, new Date());
      if (ok) tasks.push(t);
    }

    const claimed = tasks.length;

    let processed = 0;
    let errors = 0;

    const errorItems: Array<{ taskId: string; callId: string; error: string }> = [];

    for (const t of tasks) {
      try {
        // best-effort: call -> PROCESSING
        try {
          await db.call.update({
            where: { id: t.callId },
            data: { status: CallStatus.PROCESSING },
          });
        } catch {
          // ignore
        }

        await processCall(t.callId);

        await markTaskDone(t.id);

        // best-effort: call -> DONE (если processCall не выставил)
        try {
          await db.call.update({
            where: { id: t.callId },
            data: { status: CallStatus.DONE },
          });
        } catch {
          // ignore
        }

        processed += 1;
      } catch (e: unknown) {
        const msg = getErrorMessage(e);

        // ВАЖНО: у тебя markTaskError(taskId, attemptAfterIncrement, message)
        // attempts в select из listDueTasks — это значение ДО increment в claimTask,
        // а claimTask делает attempts + 1. Значит сюда передаём (t.attempts + 1).
        await markTaskError(t.id, (t.attempts ?? 0) + 1, msg, new Date());

        errors += 1;
        errorItems.push({ taskId: t.id, callId: t.callId, error: msg });

        // best-effort: call -> ERROR + meta.error
        try {
          await db.call.update({
            where: { id: t.callId },
            data: {
              status: CallStatus.ERROR,
              meta: { error: msg },
            } as any,
          });
        } catch {
          // ignore
        }
      }
    }

    return NextResponse.json({
      ok: true,
      seed: { enqueuedFromNewCalls: seeded, seedLimit },
      reset: { count: resetCount },
      claimed,
      processed,
      errors,
      errorItems,
      limits: { limit },
      message: `Seeded=${seeded} Reset=${resetCount} Claimed=${claimed} Processed=${processed} Errors=${errors}`,
    });
  } catch (e: unknown) {
    console.error("[cron/process-calls] failed", e);
    const msg = getErrorMessage(e);

    return NextResponse.json(
      { ok: false, message: "Cron failed", error: msg },
      { status: 503 }
    );
  }
  } finally {
    await releaseCronLock("process-calls");
  }
}

